# NeuroSeek AI — Environment Variables
# Copy this file to .env and fill in your values

# AI Provider (optional — app works without API keys using local AI)
AI_PROVIDER=local
AI_MODEL=default
# AI_API_KEY=your_api_key_here

# Web Search (optional — uses DuckDuckGo by default, no key needed)
WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_API_KEY=your_api_key_here

# Database
DATABASE_URL=sqlite:///neuroseek.db

# Server
PORT=5000
DEBUG=true
